# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit it.

# The Gmail account that will SEND the form emails.
# Must have 2-Step Verification enabled.
GMAIL_USER=your-gmail@gmail.com

# A 16-character Gmail App Password (NOT your Gmail login password).
# Generate at: https://myaccount.google.com/apppasswords
# Paste with NO spaces (Google shows it with spaces — remove them).
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where quote requests should be delivered.
# Can be the same as GMAIL_USER, or a different address.
MAIL_TO=utwchico@gmail.com
