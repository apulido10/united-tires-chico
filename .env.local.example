# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit it.
#
# The contact form posts to FormSubmit, which relays it to the shop inbox.
# Nothing here is required in production — the recipient defaults to the
# shop address in app/actions/send-contact.ts.

# Optional: send form submissions somewhere else while developing, so you
# don't fill the shop inbox with test messages. Any address you set here must
# confirm FormSubmit's one-time activation email before it starts receiving.
# CONTACT_FORM_EMAIL=you@example.com
